# Salin file ini menjadi .env (atau .env.local) lalu isi nilainya. Jangan commit file .env.

# ── Backend ──────────────────────────────────────────────
# URL backend Stashly (tanpa garis miring di akhir). Wajib diisi di production.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Database (dipakai NextAuth untuk user, akun, dan sesi) ─
# Harus database yang SAMA dengan backend.
DATABASE_URL="postgresql://postgres:password@localhost:5432/stashly"

# ── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# String acak panjang. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=""

# ── Google OAuth (Google Cloud > Google Auth Platform > Clients) ─
# Authorized JavaScript origin : http://localhost:3000
# Authorized redirect URI      : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Google Picker (impor file & pilih folder dari Google Drive) ─
# API key: Google Cloud > APIs & Services > Credentials > Create credentials > API key
#   - API restrictions        : Google Picker API
#   - Application restrictions: HTTP referrers -> http://localhost:3000/* dan https://domain-anda/*
NEXT_PUBLIC_GOOGLE_API_KEY=""
# Project number (angka, bukan project ID) dari Google Cloud > Dashboard.
# Sama dengan angka di depan GOOGLE_CLIENT_ID (sebelum tanda "-").
NEXT_PUBLIC_GOOGLE_APP_ID=""

# ── Halaman legal ────────────────────────────────────────
# Email kontak yang tampil di /privacy dan /terms (wajib untuk verifikasi Google).
NEXT_PUBLIC_CONTACT_EMAIL=""
